# --- Google Cloud / Vertex AI ---------------------------------------------
# Copy this file to `.env` and fill in your values.

# Your Google Cloud project ID (REQUIRED).
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Region the models run in (optional; defaults to us-central1).
GOOGLE_CLOUD_LOCATION=us-central1

# Gemini chat model (must be available in your project + region).
LLM_MODEL=gemini-2.5-flash

# Service-account key file (ONLY for servers / production).
# On a dev machine, leave this unset and run:
#   gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json

# --- Supabase --------------------------------------------------------------
# From Supabase dashboard > Project Settings > API.
SUPABASE_URL=
# Publishable key (sb_publishable_...). The old SUPABASE_ANON_KEY also works.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). The old SUPABASE_SERVICE_KEY also works.
SUPABASE_SECRET_KEY=

# Postgres connection string for migrations (migrate.py).
# Supabase > Project Settings > Database > Connection string (URI).
DATABASE_URL=

# --- Agent sessions --------------------------------------------------------
# Secret for signing widget session tokens (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-me-in-production
SESSION_TOKEN_TTL_MINUTES=60

# --- Voice agent (Google Speech-to-Text / Text-to-Speech) ------------------
VOICE_LANGUAGE_CODE=en-US
VOICE_NAME=

# --- Google Calendar booking ----------------------------------------------
# ensight's OAuth Web-application client (Calendar API enabled). Businesses
# connect their own Google account through it. From Google Cloud Console >
# APIs & Services > Credentials.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match an authorized redirect URI on the OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/google/callback
# Dashboard URL the owner returns to after connecting.
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=test-sk-email
ZEPTO_TOKEN=

